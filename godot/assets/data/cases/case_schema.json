{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "res://assets/data/cases/case_schema.json",
  "title": "Tattletale neighborhood case (schema 1)",
  "description": "Editor aid for case files. The authority is scripts/city/city_case_schema.gd (stricter: references, evidence order, original-slot rules). Keys starting with _ are notes. Guide: artifacts/pacifist-foundation/CASE_AUTHORING.md.",
  "type": "object",
  "required": ["schema", "id", "version", "title", "stages"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,47}$", "description": "Stable forever: saves and rewards key on it."},
    "version": {"type": "integer", "minimum": 1, "description": "Raise when stages change; saves from older versions migrate."},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "status": {"enum": ["ready", "draft"], "default": "ready"},
    "kind": {"const": "case"},
    "legacy_slot": {"type": "boolean", "description": "Only for the six original case ids; must keep title, reward and stage count."},
    "template": {"type": "string", "description": "Template id from templates/*.json."},
    "params": {"type": "object", "description": "Fills {param} placeholders of the template."},
    "reward": {"type": "object", "properties": {"points": {"type": ["integer", "string"], "minimum": 0, "maximum": 10000}}, "additionalProperties": false},
    "discovery": {
      "type": "object",
      "properties": {
        "trigger": {"enum": ["offer", "incident", "none"]},
        "givers": {"type": "array", "items": {"type": "string"}},
        "requires_completed": {"type": "array", "items": {"type": "string"}},
        "locked_reason": {"type": "string"}, "pitch": {"type": "string"}, "accept": {"type": "string"}, "decline": {"type": "string"}, "start_notice": {"type": "string"}
      }
    },
    "participants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["actors"],
        "properties": {
          "actors": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Actor ids, @role tokens (narrative ROLES) or incident:offender|victim|witness; first present one takes the role."},
          "label": {"type": "string"}, "speaker": {"type": "string"}, "bind": {"enum": ["case", "step"]}, "stand_in_line": {"type": "string"}
        }
      }
    },
    "props": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["builder", "placement"],
        "properties": {
          "builder": {"enum": ["satchel", "parcel", "dumped_bags", "tool_caddy", "torn_notice", "lantern", "checkpoint", "crate", "marker"]},
          "title": {"type": "string"},
          "placement": {"type": "object", "properties": {"route_metres": {"type": ["number", "string"]}, "radius": {"type": ["number", "string"]}, "tolerance": {"type": "number"}}},
          "solid": {"type": "boolean"}, "photo_height": {"type": "number"}, "photo_radius": {"type": "number"}, "tag_height": {"type": "number"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {"type": "object", "properties": {"kind": {"enum": ["observation", "photo", "testimony", "item", "report"]}, "label": {"type": "string"}}}
    },
    "incident": {"type": "object", "properties": {"templates": {"type": "array", "items": {"type": "string"}}, "radius": {"type": "number"}}},
    "stages": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"}, "objective": {"type": "string"}, "complete": {"enum": ["all", "any"]},
          "objectives": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/objective"}}
        }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": {"type": "object", "properties": {"rewarded": {"type": "boolean"}, "terminal": {"type": "boolean"}, "banner": {"type": "string"}, "notice": {"type": "string"}}}
    },
    "completion": {"type": "object", "properties": {"outcome": {"type": "string"}}}
  },
  "$defs": {
    "objective": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "verb": {"enum": ["talk", "examine", "collect", "deliver", "interview", "report", "photo", "visit", "follow", "flee", "await_incident"]},
        "objective": {"type": "string"}, "prompt": {"type": "string"}, "dialogue": {"type": "string"}, "speaker": {"type": "string"}, "notice": {"type": "string"},
        "target": {"type": "string", "description": "participant role, or prop:<id> for examine/collect"},
        "subject": {"type": "string", "description": "photo/follow: participant role, prop:<id>, actor:<id>, incident:<role>, route:<m>, pos:x,y,z"},
        "location": {"type": "string"}, "from": {"type": "string"}, "item": {"type": "string"},
        "grants": {"type": "array", "items": {"type": "string"}},
        "requires_evidence": {"type": "array", "items": {"type": "string"}, "description": "evidence ids; \"a|b\" accepts either"},
        "requires": {"type": "array", "items": {"type": "string"}},
        "hide_props": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "boolean"}, "ends_case": {"type": "string"},
        "greeting": {"type": "string"}, "farewell": {"type": "string"}, "missing": {"type": "string"}, "incident": {"type": "boolean"},
        "topics": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "ask": {"type": "string"}, "answer": {"type": "string"},
          "required": {"type": "boolean"}, "after": {"type": "array", "items": {"type": "string"}}}}},
        "hide_after": {"type": "boolean"},
        "max_distance": {"type": "number"}, "min_distance": {"type": "number"}, "min_centrality": {"type": "number"},
        "count": {"type": ["integer", "string"]}, "min_interval_minutes": {"type": ["number", "string"]}, "require_tags": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
        "time_window": {"type": "object", "properties": {"from": {"type": "number"}, "to": {"type": "number"}}},
        "area": {"type": "object", "properties": {"near": {"type": "string"}, "radius": {"type": "number"}}},
        "radius": {"type": "number"}, "dwell": {"type": "number"},
        "seconds": {"type": ["number", "string"]}, "unseen": {"type": "boolean"}, "view_range": {"type": "number"}, "view_cone": {"type": "number"}, "lose_after": {"type": "number"},
        "on_fail": {"type": "string"}, "distance": {"type": "number"}, "within": {"type": "number"}, "on_timeout": {"type": "string"},
        "states": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
