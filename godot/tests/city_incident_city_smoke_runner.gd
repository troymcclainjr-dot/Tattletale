extends "res://tests/city_priorities_session_fixture.gd"
## Full exported city; original weighted templates, unpinned people and routes.
## Only the spawn cadence is accelerated. Never calls tick(), creates records,
## moves a performer, disables population processing, or changes template weights.
const SITE_IDS := ["greenmount_wyanoke", "old_york_cator", "old_york_wyanoke"]
const SITE_FRAMES := 1080
const ATTEMPT_INTERVAL := 120
var incidents: Node
var tracks: Dictionary = {}
var reasons: Dictionary = {}
var attempts: Array[Dictionary] = []
var sites: Array[Dictionary] = []
var max_live := 0
var max_borrowed := 0
var unsafe_samples: Array[Dictionary] = []
var all_player_safe := true
var probe := PhysicsShapeQueryParameters3D.new()
var support := PhysicsRayQueryParameters3D.new()

func _watchdog() -> void:
	await get_tree().create_timer(900.0, true, false, true).timeout
	if not finished:
		check(false, "full-city incidents finish within 900 wall seconds")
		_finish()

func _run() -> void:
	if not await boot_world():
		_finish()
		return
	incidents = level.get("incidents")
	check(incidents != null, "production incident manager exists")
	if incidents == null:
		_finish()
		return
	# Direct production attempts replace only the long automatic spawn cooldown.
	# The normal level physics loop continues to own all incident ticks.
	incidents.set_spawning_enabled(false)
	var capsule := CapsuleShape3D.new()
	capsule.radius = 0.20
	capsule.height = 1.3
	probe.shape = capsule
	probe.collision_mask = 2 | 16
	probe.margin = 0.001
	support.collision_mask = 1
	var initial_health: float = float(level.combat.health)
	var starting_clock: float = float(incidents._clock)
	result_details["method"] = {"spawn": "production _try_spawn, original weighted ambient pool",
		"ticks": "normal level physics only", "site_frames": SITE_FRAMES, "attempt_interval_frames": ATTEMPT_INTERVAL,
		"timings": "spawn-call wall microseconds, includes planner; not incident tick cost or FPS",
		"clearance": "independent 0.20 m radius / 1.3 m inner capsule at actual moving body; buildings and solid props/cars",
		"support": "terrain ray under actual feet; normal >= 0.7, foot gap <= 0.27 m",
		"templates_sha256": FileAccess.get_sha256("res://scripts/city/city_incident_templates.gd")}
	for site_id in SITE_IDS:
		begin_phase("natural-incidents-" + site_id)
		var mark: Dictionary = {}
		# The runtime walking itinerary filters level.landmarks to its ordered
		# stops; consult the complete exported catalog for Greenmount/Wyanoke.
		for candidate in level.level_data.get("landmarks", []):
			if str(candidate.get("id", "")) == site_id:
				mark = candidate
		check(not mark.is_empty(), "exported route landmark exists: " + site_id)
		if mark.is_empty():
			continue
		var desired: Vector3 = level.vector(mark.position)
		var standing := _site_foot(desired)
		check(not standing.is_empty(), "route site has clear supported sidewalk: " + site_id)
		if standing.is_empty():
			continue
		# Player-only scene arrangement. Unlike _place_player, this does not reset
		# ongoing police calls. Existing incidents leave through their real rules.
		_set_scenario_position(Vector3(standing.position) + Vector3.UP * 0.04)
		level.set("_safe_position", player.global_position)
		level.resume_exploring()
		await frames(120)
		var site := {"id": site_id, "player": _xyz(player.global_position), "eligible_neighbors": _candidate_count(),
			"clock_start": float(incidents._clock), "attempt_start": attempts.size()}
		check(int(site.eligible_neighbors) > 0, "busy real route has loaded eligible neighbors: " + site_id)
		for frame in SITE_FRAMES:
			if frame % ATTEMPT_INTERVAL == 0:
				_attempt(site_id)
			await frames(1)
			_observe()
			all_player_safe = all_player_safe and player.enabled and float(level.combat.health) >= initial_health \
				and int(level.law.wanted) == 0 and not bool(level.paused)
		site["clock_end"] = float(incidents._clock)
		site["attempt_end"] = attempts.size()
		site["status"] = incidents.get_status()
		sites.append(site)
		_save_evidence()
	var movers := 0
	var progressed := 0
	for track in tracks.values():
		if float(track.travelled) >= 1.0 and float(track.max_displacement) >= 0.75 and int(track.moving_samples) >= 10:
			movers += 1
		if int(track.max_step) > 0 or float(track.target_progress) >= 1.0:
			progressed += 1
	check(tracks.size() >= 2, "at least two incidents generated by original natural selection")
	check(movers >= 2, "at least two real borrowed performers walk over one metre")
	check(progressed >= 2, "at least two performers advance a planned leg or make one metre of destination progress")
	check(max_live <= 2 and max_borrowed <= 4, "live incidents capped at two and simultaneous borrowed performers at four")
	check(unsafe_samples.is_empty(), "observed walking retains terrain support and obstacle clearance without teleporting")
	check(all_player_safe, "player stays alive, active, unharmed and without wanted heat")
	check(float(incidents._clock) - starting_clock >= 40.0, "real production ticks advance at least forty seconds")
	check(int(level.npcs.crowd.get_status().total) == 1200 and int(level.residents.get_status().count) == 40 \
		and level.traffic.vehicles.size() == 90, "full city population retained at completion")
	check(_window_off_desktop() and Input.mouse_mode == Input.MOUSE_MODE_VISIBLE, "offscreen run retains visible pointer and unfocused window")
	_save_evidence()
	_finish()

func _site_foot(desired: Vector3) -> Dictionary:
	# Arrange only the observer on actual sidewalk; never put the observer in
	# traffic or alter a candidate resident to make a spawn work.
	var candidates: Array[Vector3] = [desired]
	var near: Dictionary = incidents._nearest_road(desired)
	if not near.is_empty():
		var segment: Dictionary = near.seg
		for offset in [8.0, -8.0, 14.0, -14.0]:
			for side in [1.0, -1.0]:
				candidates.append(Vector3(near.closest) + Vector3(segment.tangent) * offset \
					+ Vector3(segment.across) * side * (float(segment.half) + 1.8))
	for candidate in candidates:
		if not incidents._on_sidewalk(candidate):
			continue
		var standing: Dictionary = incidents.actors.tactics.walkable(candidate)
		if not standing.is_empty():
			return standing
	return {}

func _candidate_count() -> int:
	# Read the same active cell membership without consuming planner RNG.
	var count := 0
	var crowd = level.npcs.crowd
	for cell in crowd._cells.values():
		if (cell.nodes as Array).is_empty():
			continue
		for index in cell.resident_indices:
			var resident: Dictionary = crowd.residents[index]
			var distance := flat_distance(resident.position, player.global_position)
			if distance >= 30.0 and distance <= 90.0 and incidents._crowd_free(resident):
				count += 1
	return count

func _attempt(site_id: String) -> void:
	# Snapshot actual source slots before borrowing, never pin or move them.
	var origins: Dictionary = {}
	for index in level.npcs.crowd.residents.size():
		origins["crowd_%d" % index] = level.npcs.crowd.residents[index].position
	var began := Time.get_ticks_usec()
	var outcome: Dictionary = incidents._try_spawn()
	var elapsed := Time.get_ticks_usec() - began
	var reason := "spawned" if bool(outcome.get("ok", false)) else str(outcome.get("reason", "unknown"))
	reasons[reason] = int(reasons.get(reason, 0)) + 1
	attempts.append({"site": site_id, "clock": float(incidents._clock), "microseconds": elapsed,
		"reason": reason, "incident_id": str(outcome.get("incident_id", "")), "eligible_neighbors": _candidate_count()})
	if not bool(outcome.get("ok", false)):
		return
	var id := str(outcome.incident_id)
	var live: Dictionary = incidents._live[id]
	var offender := str(live.offender)
	var record: Dictionary = incidents.get_incident(id)
	var origin: Vector3 = origins.get(offender, Vector3.INF)
	var body = incidents.actors.actor_of(offender)
	var start: Vector3 = body.global_position if body != null else origin
	check(origin.is_finite() and origin.distance_to(start) < 0.05 and str(record.source) == "world",
		"naturally generated " + id + " retains real resident origin")
	var distance := flat_distance(start, player.global_position)
	check(distance >= 29.99 and distance <= 90.01, "natural spawn stays in production 30–90 m band: " + id)
	var target := Vector3.INF
	for step in live.steps:
		if str(step.op) == "walk":
			target = step.to
			break
	tracks[id] = {"id": id, "site": site_id, "template": str(record.template), "offender": offender,
		"origin": origin, "start": start, "last": start, "last_clock": float(incidents._clock), "target": target,
		"travelled": 0.0, "max_displacement": 0.0, "moving_samples": 0, "support_samples": 0,
		"max_step": 0, "target_progress": 0.0, "max_blocked_seconds": 0.0, "released": false}
	_observe()

func _observe() -> void:
	max_live = maxi(max_live, incidents._live.size())
	max_borrowed = maxi(max_borrowed, incidents.actors.performers.size())
	var space := level.get_world_3d().direct_space_state
	for id in tracks:
		var track: Dictionary = tracks[id]
		var body = incidents.actors.actor_of(str(track.offender))
		if body == null:
			track.released = true
			continue
		var at: Vector3 = body.global_position
		var previous: Vector3 = track.last
		var moved := flat_distance(at, previous)
		var delta := maxf(0.0, float(incidents._clock) - float(track.last_clock))
		track.travelled = float(track.travelled) + moved
		track.max_displacement = maxf(float(track.max_displacement), flat_distance(at, track.start))
		if Vector3(track.target).is_finite():
			track.target_progress = maxf(float(track.target_progress), flat_distance(track.start, track.target) - flat_distance(at, track.target))
		var live: Dictionary = incidents._live.get(id, {})
		track.max_step = maxi(int(track.max_step), int(live.get("step", 0)))
		track.max_blocked_seconds = maxf(float(track.max_blocked_seconds), float(live.get("blocked", 0.0)))
		if moved > 0.001:
			track.moving_samples = int(track.moving_samples) + 1
			probe.transform = Transform3D(Basis.IDENTITY, at + Vector3.UP * 0.85)
			probe.exclude = [body.get_rid()]
			var overlaps: Array = space.intersect_shape(probe, 4)
			support.from = at + Vector3.UP * 0.5
			support.to = at - Vector3.UP * 0.6
			var hit: Dictionary = space.intersect_ray(support)
			var supported: bool = not hit.is_empty() and Vector3(hit.normal).y >= 0.7 and absf(at.y - Vector3(hit.position).y) <= 0.27
			track.support_samples = int(track.support_samples) + 1
			if (not overlaps.is_empty() or not supported or moved > 2.65 * delta + 0.025) and unsafe_samples.size() < 32:
				var blockers: Array[String] = []
				for overlap in overlaps:
					blockers.append(str(overlap.collider.get_path()))
				unsafe_samples.append({"id": id, "at": _xyz(at), "clock": float(incidents._clock),
					"metres": moved, "delta": delta, "supported": supported, "blockers": blockers})
		track.last = at
		track.last_clock = float(incidents._clock)

func _save_evidence() -> void:
	var evidence: Array[Dictionary] = []
	for track in tracks.values():
		var item: Dictionary = track.duplicate(true)
		for key in ["origin", "start", "last", "target"]:
			item[key] = _xyz(item[key]) if Vector3(item[key]).is_finite() else []
		item["record"] = incidents.get_incident(str(item.id))
		evidence.append(item)
	result_details["incidents"] = {"sites": sites, "attempts": attempts, "reason_histogram": reasons,
		"performers": evidence, "max_live": max_live, "max_simultaneously_borrowed": max_borrowed,
		"unsafe_samples": unsafe_samples, "final_status": incidents.get_status()}
	var file := FileAccess.open(output_dir.path_join("incident-evidence.json"), FileAccess.WRITE)
	if file != null:
		file.store_string(JSON.stringify(result_details, "\t"))
		file.flush()

func _xyz(value: Vector3) -> Array:
	return [value.x, value.y, value.z]
