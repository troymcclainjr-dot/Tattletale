	"cards": [
		{"id": "block_01",
		 "lines": [
			{"text": "Rose Hill Terrace, I was raised on the block", "syl": [[0, "Rose", 2], [2, "Hill", 1], [4, "Ter", 2], [5, "race", 0], [6, "I", 0], [7, "was", 0], [8, "raised", 2], [10, "on", 0], [11, "the", 0], [12, "block", 2]]},
